{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"trailingComma": "none",
	"arrowParens": "avoid",
	"endOfLine": "lf",
	"sortImports": {},
	"sortPackageJson": true,
	"ignorePatterns": ["pnpm-lock.yaml", "public/**"]
}
